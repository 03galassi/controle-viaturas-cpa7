const KEY="pao_da_dilma_v33";
// Imagens embutidas para garantir que o GitHub Pages as carregue mesmo se a pasta assets nao for servida corretamente.
const HERO_IMAGE="data:image/jpeg;base64,";
const PAO_IMAGE="data:image/jpeg;base64,";
const PAO_DOCE_IMAGE="data:image/jpeg;base64,";

const stored=JSON.parse(localStorage.getItem(KEY)||'{}');
const state=Object.assign({clients:[],sales:[],costs:[],reports:[],receipts:[],credits:[]},stored);
state.reports=Array.isArray(state.reports)?state.reports:[];
state.clients=Array.isArray(state.clients)?state.clients:[];
state.sales=Array.isArray(state.sales)?state.sales:[];
state.costs=Array.isArray(state.costs)?state.costs:[];
state.receipts=Array.isArray(state.receipts)?state.receipts:[];
const $=s=>document.querySelector(s);
const money=v=>new Intl.NumberFormat("pt-BR",{style:"currency",currency:"BRL"}).format(Number(v||0));
const today=()=>{const d=new Date();const p=n=>String(n).padStart(2,"0");return `${d.getFullYear()}-${p(d.getMonth()+1)}-${p(d.getDate())}`};
const tomorrow=()=>{const d=new Date();d.setDate(d.getDate()+1);const p=n=>String(n).padStart(2,"0");return `${d.getFullYear()}-${p(d.getMonth()+1)}-${p(d.getDate())}`};
const defaultSaleDate=()=>{const d=new Date();const day=d.getDay();d.setDate(d.getDate()+(day===6?2:1));const p=n=>String(n).padStart(2,"0");return `${d.getFullYear()}-${p(d.getMonth()+1)}-${p(d.getDate())}`};
const monthNow=()=>today().slice(0,7);
const todayDate=()=>{const d=new Date();const p=n=>String(n).padStart(2,"0");return `${d.getFullYear()}-${p(d.getMonth()+1)}-${p(d.getDate())}`};
let deliveryViewDate=todayDate();
const esc=s=>String(s??"").replace(/[&<>"']/g,m=>({"&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;","'":"&#39;"}[m]));
function save(){localStorage.setItem(KEY,JSON.stringify(state));updateBottomNav();}
function receiptTotalFor(cid,month){return state.receipts.filter(r=>r.clientId===cid&&r.month===month).reduce((a,r)=>a+Number(r.amount||0),0)}
function creditTotalFor(cid){return state.credits.filter(c=>c.clientId===cid).reduce((a,c)=>a+Number(c.amount||0),0)}
function addCredit(cid,amount){if(!cid||amount<=0)return;state.credits.push({id:crypto.randomUUID(),clientId:cid,amount:Number(amount),date:today()});}
function useCredit(cid,amount){let remaining=Math.max(0,Number(amount)||0);if(!cid||remaining<=0)return 0;for(const c of state.credits.filter(x=>x.clientId===cid&&Number(x.amount)>0)){const use=Math.min(remaining,Number(c.amount));c.amount=Number((Number(c.amount)-use).toFixed(2));remaining-=use;if(remaining<=0)break;}state.credits=state.credits.filter(c=>Number(c.amount)>0.009);return Number((Number(amount)-remaining).toFixed(2));}
function receivableTotal(){const groups={};state.sales.filter(s=>s.delivered&&!s.paid).forEach(s=>{const month=(s.payment==="prazo"?(s.payDate||s.date):s.date).slice(0,7);const k=s.clientId+"_"+month;(groups[k]??={cid:s.clientId,month,total:0});groups[k].total+=Number(s.total||0)});return Object.values(groups).reduce((a,g)=>a+Math.max(0,g.total-receiptTotalFor(g.cid,g.month)),0)}
function updateBottomNav(){const el=$("#navDueAmount");if(el)el.textContent="R$";updateBadges();}
function openModal(html){$("#modalBody").innerHTML=html;$("#modal").classList.remove("hidden")}
function closeModal(){$("#modal").classList.add("hidden")}
$("#closeModal").onclick=closeModal; $("#modal").onclick=e=>{if(e.target.id==="modal")closeModal()};
function toast(t){let x=document.createElement("div");x.className="toast";x.textContent=t;document.body.appendChild(x);setTimeout(()=>x.remove(),2400)}
function wa(phone,msg){let p=String(phone||"").replace(/\D/g,"");if(p.length===10)p="55"+p;if(p.length===11)p="55"+p;location.href=`https://wa.me/${p}?text=${encodeURIComponent(msg)}`}
function maps(addr){return "https://www.google.com/maps/search/?api=1&query="+encodeURIComponent(addr||"")}
function imageFallback(img,kind){img.style.display="none";img.parentElement.classList.add("imageFallback",kind||"")}

function renderHome(){
 const sales=state.sales.filter(s=>s.date===today());
 const total=sales.reduce((a,s)=>a+Number(s.total),0);
 const due=state.sales.filter(s=>(s.payment==="prazo"&&s.paid!==true)||(s.payment!=="prazo"&&s.delivered&&s.paid!==true));
 const deliveries=sales.filter(s=>!s.delivered).length;
 const costsMonth=state.costs.filter(c=>String(c.date||"").slice(0,7)===monthNow()).reduce((a,c)=>a+Number(c.total||0),0);
 $("#content").innerHTML=`
 <section class="hero"><img src="${HERO_IMAGE}" alt="Pão da Dilma" onerror="imageFallback(this,'heroFallback')"><div class="heroOverlay"><h1>PÃO<br><span class="gold">DA DILMA</span></h1><p>🚚 ENTREGA RÁPIDA &nbsp; ★ QUALIDADE SEMPRE &nbsp; ♥ CLIENTES SATISFEITOS</p></div></section>
 <section class="stats">
  <button type="button" class="stat" onclick="navigate('sales')" aria-label="Abrir vendas"><div class="ico">🛒</div><small>Vendas hoje</small><strong>${money(total)}</strong><small>${sales.length} vendas</small></button>
  <button type="button" class="stat" onclick="navigate('deliveries')" aria-label="Abrir entregas"><div class="ico">🚚</div><small>Entregas hoje</small><strong>${deliveries}</strong><small>a realizar</small></button>
  <button type="button" class="stat" onclick="navigate('clients')" aria-label="Abrir clientes"><div class="ico">👥</div><small>Clientes</small><strong>${state.clients.length}</strong><small>cadastrados</small></button>
  <button type="button" class="stat" onclick="navigate('receivables')" aria-label="Abrir contas a receber"><div class="ico">💰</div><small>A receber</small><strong>R$</strong><small>ver contas</small></button>
 </section>
 <section class="actions"><button class="action sale" onclick="newSale()">🛒 NOVA VENDA <span>›</span></button><button class="action client" onclick="newClient()">👤 NOVO CLIENTE <span>›</span></button></section>
 <section class="products">
  <div class="product" onclick="newSale('pao')"><img src="${PAO_IMAGE}" alt="Pão" onerror="imageFallback(this,'breadFallback')"><h3>PÃO</h3></div>
  <div class="product" onclick="newSale('doce')"><img src="${PAO_DOCE_IMAGE}" alt="Pão doce" onerror="imageFallback(this,'sweetFallback')"><h3>PÃO DOCE</h3></div>
 </section>
 <section class="panel"><div class="panelTitle">◷ Últimas vendas <button class="btn" onclick="navigate('sales')">Ver todas ›</button></div>
 ${sales.slice(-3).reverse().map(s=>saleRow(s)).join("") || '<div class="empty">Nenhuma venda registrada hoje.</div>'}</section>`;
 updateBadges();
}
function saleRow(s){
 const c=state.clients.find(x=>x.id===s.clientId)||{name:s.clientName||"Cliente"};
 const initials=String(c.name||"Cliente").split(" ").map(x=>x[0]).slice(0,2).join("");
 return `<div class="listRow"><div class="avatar">${esc(initials)}</div><div><b>${esc(c.name||"Cliente")}</b><div class="muted">${s.time||""}</div></div><div class="details muted">${s.qty} ${s.type==="pao"?"pães":"pães doces"} ${s.unitPrice?` · ${money(s.unitPrice)}/un.`:""}</div><div class="amount"><span class="pill ${s.delivered?"ok":"wait"}">${s.delivered?"Entregue":"A entregar"}</span><br><b>${money(s.total)}</b><div class="saleActions"><button class="btn editSaleBtn" onclick="editSale('${s.id}')">✏️ Editar</button><button class="btn deleteSaleBtn" onclick="deleteSale('${s.id}')">🗑️ Excluir</button></div></div></div>`
}
function renderClients(filter=""){
 const list=state.clients.filter(c=>(c.name+" "+c.phone+" "+c.address).toLowerCase().includes(filter.toLowerCase()));
 $("#content").innerHTML=`<h2 class="screenTitle">Clientes</h2><div class="toolbar"><button class="btn primary" onclick="newClient()">+ Novo cliente</button></div><section class="panel">${list.map(c=>`<div class="listRow clientRow"><div class="avatar">${esc(c.name.split(" ").map(x=>x[0]).slice(0,2).join(""))}</div><div><b>${esc(c.name)}</b><div class="muted">${esc(c.phone)} · ${esc(c.address)}</div></div><div class="clientActions"><a class="mapBtn" href="${maps(c.address)}" target="_blank" aria-label="Abrir endereço no Maps">📍</a><button class="btn editBtn" onclick="editClient('${c.id}')">✏️ Editar</button><button class="btn deleteBtn" onclick="deleteClient('${c.id}')">🗑️ Excluir</button></div></div>`).join("")||'<div class="empty">Nenhum cliente encontrado.</div>'}</section>`;
}
function renderSales(){
 const list=[...state.sales].reverse();
 $("#content").innerHTML=`<h2 class="screenTitle">Vendas</h2><div class="toolbar"><button class="btn primary" onclick="newSale()">+ Nova venda</button></div><section class="panel">${list.map(s=>saleRow(s)).join("")||'<div class="empty">Nenhuma venda registrada.</div>'}</section>`;
}
function renderDeliveries(){
 const selected=deliveryViewDate||todayDate();
 const list=state.sales.filter(s=>(s.date===selected&&!s.delivered)||s.deliveredAt===selected).map(s=>({...s,c:state.clients.find(c=>c.id===s.clientId)||{name:s.clientName||"Cliente",address:s.clientAddress||""}}));
 const label=new Date(`${selected}T12:00:00`).toLocaleDateString("pt-BR",{weekday:"long",day:"2-digit",month:"2-digit",year:"numeric"});
 const rows=list.map(s=>`<div class="listRow"><div class="avatar">🚚</div><div><b>${esc(s.c?.name||"Cliente")}</b><div class="muted">${s.where==="trabalho"?"🏢 Trabalho":"🏠 Casa"} · ${esc(s.c?.address||"")}</div></div><a class="mapBtn" href="${maps(s.c?.address||"")}" target="_blank">🗺️</a>${s.delivered?`<span class="pill ok">Entregue</span>`:`<button class="btn primary" onclick="deliver('${s.id}')">Entregue</button>`}</div>`).join("");
 $("#content").innerHTML=`<h2 class="screenTitle">Entregas</h2><section class="panel"><div class="deliveryDateBox"><label><b>Data das entregas</b><input id="deliveryDate" type="date" value="${selected}" onchange="changeDeliveryDate(this.value)"></label><span class="pill wait">${esc(label)}</span></div><div class="deliveryHint">Visualização padrão: <b>hoje</b>. Você pode escolher qualquer outra data.</div>${rows||`<div class="empty">Nenhuma entrega para ${esc(label)}.</div>`}<div class="toolbar"><button class="btn gold" onclick="openRoute()">🗺️ Abrir endereços no Maps</button></div></section>`;
}
function changeDeliveryDate(v){deliveryViewDate=v||todayDate();renderDeliveries()}
function renderReceivables(){
 const due=state.sales.filter(s=>s.delivered&&!s.paid);
 const groups={};
 due.forEach(s=>{const c=state.clients.find(c=>c.id===s.clientId);const month=(s.payment==="prazo"?(s.payDate||s.date):s.date).slice(0,7);const k=s.clientId+"_"+month;(groups[k]??={client:c,month,total:0,sales:[]});groups[k].total+=Number(s.total||0);groups[k].sales.push(s)});
 Object.values(groups).forEach(g=>{g.received=receiptTotalFor(g.client?.id,g.month);g.balance=Math.max(0,g.total-g.received)});
 const entries=Object.entries(groups).filter(([k,g])=>g.balance>0);
 $("#content").innerHTML=`<h2 class="screenTitle">A receber</h2><section class="panel">${entries.map(([k,g])=>`<div class="listRow"><div class="avatar">💰</div><div><button class="linkBtn" onclick="showPurchaseReport('${k}')" title="Ver compras do mês"><b>${esc(g.client?.name||"Cliente")}</b></button><div class="muted">${monthLabel(g.month)} · ${g.sales.length} venda(s)</div><div class="muted small">👆 Ver compras do mês${g.received?` · Já pago: ${money(g.received)}`:""}</div></div><div><b>${money(g.balance)}</b><div class="muted ${g.sales.some(s=>s.payDate<today())?'danger':''}">${(g.sales.some(s=>s.payment==="mensal")?'MENSAL':(g.sales.some(s=>s.payment==="prazo"&&s.payDate<today())?'VENCIDO':(g.sales.some(s=>s.payment!=="prazo")?'AGUARDANDO RECEBIMENTO':'A vencer')))}</div></div><div><button class="btn gold" onclick="payGroup('${k}')">Recebido</button>${g.sales.some(s=>s.payDate<today())?`<button class="btn" onclick="charge('${g.client.id}','${g.balance}')">WhatsApp</button>`:""}</div></div>`).join("")||'<div class="empty">Nenhuma conta em aberto.</div>'}</section>`;
}
function renderCosts(){
 const current=state.costs.filter(c=>String(c.date||"").slice(0,7)===monthNow());
 const total=current.reduce((a,c)=>a+Number(c.total||0),0);
 $("#content").innerHTML=`<h2 class="screenTitle">Gastos com matéria-prima</h2>
 <section class="panel costSummary"><div><small class="muted">Total deste mês</small><strong>${money(total)}</strong></div><button class="btn primary" onclick="newCost()">+ Lançar gasto</button></section>
 <section class="panel">${[...state.costs].sort((a,b)=>String(b.date).localeCompare(String(a.date))).map(c=>`<div class="listRow costRow"><div class="avatar">🧾</div><div><b>${esc(c.item)}</b><div class="muted">${esc(c.date)}${c.supplier?" · "+esc(c.supplier):""}</div></div><div class="details muted">${c.qty?esc(c.qty)+" · ":""}${esc(c.note||"")}</div><div class="amount"><b>${money(c.total)}</b><br><button class="btn" onclick="deleteCost('${c.id}')">Excluir</button></div></div>`).join("")||'<div class="empty">Nenhum gasto com matéria-prima lançado.</div>'}</section>`;
}
function monthLabel(m){const [y,mo]=m.split("-").map(Number);return new Date(y,mo-1,1).toLocaleDateString("pt-BR",{month:"long",year:"numeric"}).replace(/^./,x=>x.toUpperCase())}
function previousMonth(){const d=new Date();d.setDate(1);d.setMonth(d.getMonth()-1);return d.toISOString().slice(0,7)}
function previousMonthFrom(m){const [y,mo]=m.split("-").map(Number);const d=new Date(y,mo-2,1);return d.toISOString().slice(0,7)}
function reportForMonth(m){return state.reports.find(r=>r.month===m)}
function closeEligible(){return new Date().getDate()>=10}
function monthStats(m){
 const sales=state.sales.filter(s=>String(s.date||"").slice(0,7)===m);
 const costs=state.costs.filter(c=>String(c.date||"").slice(0,7)===m);
 const revenue=sales.reduce((a,s)=>a+Number(s.total||0),0);
 const avista=sales.filter(s=>s.payment!=="prazo").reduce((a,s)=>a+Number(s.total||0),0);
 const prazo=sales.filter(s=>s.payment==="prazo").reduce((a,s)=>a+Number(s.total||0),0);
 const mensal=sales.filter(s=>s.payment==="mensal").reduce((a,s)=>a+Number(s.total||0),0);
 // Recebimentos: só entra o que foi efetivamente marcado como recebido.
 // paidAt foi adicionado nesta versão; vendas antigas sem paidAt usam a data da venda.
 const recebimentos=state.sales.filter(s=>s.paid && String(s.paidAt||s.date||"").slice(0,7)===m);
 const recebidoLegado=recebimentos.reduce((a,s)=>a+Number(s.total||0),0);
 const recebidoNovos=state.receipts.filter(r=>String(r.date||"").slice(0,7)===m);
 const recebido=recebidoLegado+recebidoNovos.reduce((a,r)=>a+Number(r.amount||0),0);
 // Contas que continuam em aberto e pertencem ao mês de referência.
 const abertoSales=state.sales.filter(s=>{
   if(s.paid) return false;
   if(s.payment==="prazo") return String(s.payDate||s.date||"").slice(0,7)===m;
   if(s.payment==="mensal") return String(s.date||"").slice(0,7)===m;
   return String(s.date||"").slice(0,7)===m;
 });
 const aberto=abertoSales.reduce((a,s)=>a+Number(s.total||0),0);
 const expense=costs.reduce((a,c)=>a+Number(c.total||0),0);
 const qty=sales.reduce((a,s)=>a+Number(s.qty||0),0);
 const aReceberAtual=receivableTotal();
 return {sales,costs,recebimentos,abertoSales,revenue,avista,prazo,mensal,recebido,aberto,aReceberAtual,expense,qty,resultado:revenue-expense};
}
function renderClosing(){
 const target=previousMonth();
 const current=monthNow();
 const archived=[...state.reports].sort((a,b)=>String(b.month).localeCompare(String(a.month)));
 const available=closeEligible(); const existing=reportForMonth(target); const st=monthStats(target);
 const currentStats=monthStats(current);
 const targetText=monthLabel(target);
 const status=existing?`Fechado em ${new Date(existing.closedAt).toLocaleDateString("pt-BR")}`:(available?`Fechamento disponível desde o dia 10.`:`Disponível no dia 10 de cada mês.`);
 $("#content").innerHTML=`<div class="screenTitleRow"><h2 class="screenTitle">Gastos e Relatórios</h2><button class="btn" onclick="navigate('home')">← Voltar</button></div>
 <section class="panel"><div class="panelTitle"><span>Relatório</span></div>
 <div class="formGrid"><label>Mês do relatório<select id="reportMonth" onchange="renderClosingForMonth(this.value)"><option value="${current}" selected>${esc(monthLabel(current))} (atual)</option><option value="${target}">${esc(targetText)} (fechamento)</option></select></label></div>
 <div class="closingGrid"><div><small>Vendas</small><b>${currentStats.sales.length}</b></div><div><small>Faturamento</small><b>${money(currentStats.revenue)}</b></div><div><small>Recebimentos</small><b>${money(currentStats.recebido)}</b></div><div><small>A receber</small><b>${money(currentStats.aReceberAtual)}</b></div><div><small>Gastos</small><b>${money(currentStats.expense)}</b></div><div><small>Resultado</small><b>${money(currentStats.revenue-currentStats.expense)}</b></div></div>
 <div class="toolbar"><button class="btn gold" onclick="previewReport('${current}')">👁️ Visualizar relatório</button><button class="btn" onclick="generatePdfNow('${current}')">📄 Gerar PDF</button></div></section>
 <section class="panel"><div class="panelTitle"><span>Fechamento mensal — ${esc(targetText)}</span><span class="pill wait">Dia 10</span></div><div class="closingGrid"><div><small>Vendas</small><b>${st.sales.length}</b></div><div><small>Pães vendidos</small><b>${st.qty}</b></div><div><small>Recebimentos</small><b>${money(st.recebido)}</b></div><div><small>A receber</small><b>${money(st.aberto)}</b></div><div><small>Gastos</small><b>${money(st.expense)}</b></div><div><small>Resultado</small><b>${money(st.resultado)}</b></div></div>
 <p class="muted">${status}</p><div class="toolbar closingActions"><button class="btn gold" onclick="previewReport('${target}')">👁️ Visualizar resumo</button><button class="btn" onclick="generatePdfNow('${target}')">📄 Gerar PDF</button>${existing?`<button class="btn primary" onclick="viewArchivedReport('${existing.id}')">📂 Ver PDF arquivado</button>`:`<button class="btn primary" ${available?`onclick="closeMonth('${target}')"`:`disabled`} >📅 Fechar mês e arquivar PDF</button>`}</div></section>
 <section class="panel"><div class="panelTitle"><span>Relatórios arquivados</span><span class="pill wait">${archived.length}</span></div>${archived.map(r=>`<div class="archiveRow"><div><b>${esc(monthLabel(r.month))}</b><div class="muted">Fechado em ${new Date(r.closedAt).toLocaleDateString("pt-BR")}</div></div><button class="btn" onclick="viewArchivedReport('${r.id}')">📄 Ver PDF</button></div>`).join("")||'<div class="empty">Nenhum fechamento mensal arquivado.</div>'}</section>`;
}
function renderClosingForMonth(m){
 const st=monthStats(m);
 const el=$("#reportMonth");
 if(!el)return;
 const panel=el.closest(".panel");
 const grid=panel.querySelector(".closingGrid");
 grid.innerHTML=`<div><small>Vendas</small><b>${st.sales.length}</b></div><div><small>Faturamento</small><b>${money(st.revenue)}</b></div><div><small>Recebimentos</small><b>${money(st.recebido)}</b></div><div><small>A receber</small><b>${money(st.aReceberAtual)}</b></div><div><small>Gastos</small><b>${money(st.expense)}</b></div><div><small>Resultado</small><b>${money(st.revenue-st.expense)}</b></div>`;
 const buttons=panel.querySelectorAll(".toolbar button");
 if(buttons[0])buttons[0].setAttribute("onclick",`previewReport('${m}')`);
 if(buttons[1])buttons[1].setAttribute("onclick",`generatePdfNow('${m}')`);
}
function previewReport(m){const st=monthStats(m);openModal(`<h2>Relatório — ${esc(monthLabel(m))}</h2><div class="reportPreview"><p><b>Total de vendas:</b> ${money(st.revenue)}</p><p><b>Quantidade de pães:</b> ${st.qty}</p><p><b>Vendas à vista:</b> ${money(st.avista)}</p><p><b>Vendas a prazo:</b> ${money(st.prazo)}</p><p><b>Vendas mensais:</b> ${money(st.mensal)}</p><p><b>Recebimentos no mês:</b> ${money(st.recebido)}</p><p><b>A receber:</b> ${money(st.aberto)}</p><p><b>A receber atual:</b> ${money(st.aReceberAtual)}</p><p><b>Gastos com matéria-prima:</b> ${money(st.expense)}</p><p><b>Resultado:</b> ${money(st.resultado)}</p></div><div class="toolbar"><button class="btn gold" onclick="closeModal();generatePdfNow('${m}')">📄 Gerar PDF</button></div>`)}
function pdfSafe(v){return String(v??"").normalize("NFD").replace(/[\u0300-\u036f]/g,"").replace(/[^\x20-\x7E]/g,"?")}
function pdfEscape(v){return pdfSafe(v).replace(/\\/g,"\\\\").replace(/\(/g,"\\(").replace(/\)/g,"\\)")}
function buildPdf(lines){
 const pageW=595,pageH=842,margin=42,lineH=15,maxLines=49; const pages=[];
 let page=[]; for(const raw of lines){const text=pdfSafe(raw);let chunks=[]; for(let i=0;i<text.length;i+=92)chunks.push(text.slice(i,i+92)); if(!chunks.length)chunks=[""]; for(const ch of chunks){if(page.length>=maxLines){pages.push(page);page=[]}page.push(ch)}} if(page.length||!pages.length)pages.push(page);
 const objs=[]; const add=o=>{objs.push(o);return objs.length}; const font=add('<< /Type /Font /Subtype /Type1 /BaseFont /Helvetica >>'); const pageIds=[]; const contentIds=[];
 for(const pg of pages){let stream=`BT\n/F1 10 Tf\n${margin} ${pageH-margin} Td\n`;pg.forEach((l,i)=>{if(i>0)stream+=`0 -${lineH} Td\n`;stream+=`(${pdfEscape(l)}) Tj\n`;});stream+='ET';contentIds.push(add(`<< /Length ${stream.length} >>\nstream\n${stream}\nendstream`));pageIds.push(add(''))}
 const pagesId=add(''); for(let i=0;i<pageIds.length;i++)objs[pageIds[i]-1]=`<< /Type /Page /Parent ${pagesId} 0 R /MediaBox [0 0 ${pageW} ${pageH}] /Resources << /Font << /F1 ${font} 0 R >> >> /Contents ${contentIds[i]} 0 R >>`;
 objs[pagesId-1]=`<< /Type /Pages /Kids [${pageIds.map(id=>id+' 0 R').join(' ')}] /Count ${pageIds.length} >>`; const catalog=add(`<< /Type /Catalog /Pages ${pagesId} 0 R >>`);
 let pdf='%PDF-1.4\n',offs=[0]; for(let i=0;i<objs.length;i++){offs[i+1]=pdf.length;pdf+=`${i+1} 0 obj\n${objs[i]}\nendobj\n`} const xref=pdf.length;pdf+=`xref\n0 ${objs.length+1}\n0000000000 65535 f \n`;for(let i=1;i<offs.length;i++)pdf+=String(offs[i]).padStart(10,'0')+' 00000 n \n';pdf+=`trailer\n<< /Size ${objs.length+1} /Root ${catalog} 0 R >>\nstartxref\n${xref}\n%%EOF`;return new TextEncoder().encode(pdf)
}
function bytesToBase64(bytes){let s="";const chunk=0x8000;for(let i=0;i<bytes.length;i+=chunk)s+=String.fromCharCode(...bytes.subarray(i,i+chunk));return btoa(s)}
function base64ToBytes(b64){const bin=atob(b64);const out=new Uint8Array(bin.length);for(let i=0;i<bin.length;i++)out[i]=bin.charCodeAt(i);return out}
function buildReportLines(m){const st=monthStats(m);const lines=["PAO DA DILMA - RELATORIO MENSAL","",`Periodo: ${monthLabel(m)}`,`Data do relatorio: ${new Date().toLocaleDateString("pt-BR")}`,"","RESUMO","----------------------------------------",`Vendas realizadas: ${st.sales.length}`,`Quantidade de paes: ${st.qty}`,`Faturamento: ${money(st.revenue)}`,`Vendas a vista: ${money(st.avista)}`,`Vendas a prazo: ${money(st.prazo)}`,`Vendas mensais: ${money(st.mensal)}`,`Recebimentos no mes: ${money(st.recebido)}`,`A receber no mes: ${money(st.aberto)}`,`A receber atual: ${money(st.aReceberAtual)}`,`Gastos com materia-prima: ${money(st.expense)}`,`Resultado (vendas - custos): ${money(st.resultado)}`,"","RECEBIMENTOS","----------------------------------------"];
 st.recebimentos.slice().sort((a,b)=>String(a.paidAt||a.date).localeCompare(String(b.paidAt||b.date))).forEach((s,i)=>lines.push(`${i+1}. ${s.paidAt||s.date} - ${s.clientName||"Cliente"} - ${money(s.total)} - ${s.payment==="prazo"?"A prazo":"A vista"}`));
 lines.push("","CONTAS A RECEBER / EM ABERTO","----------------------------------------"); st.abertoSales.slice().sort((a,b)=>String(a.payDate||a.date).localeCompare(String(b.payDate||b.date))).forEach((s,i)=>lines.push(`${i+1}. ${s.payDate||s.date} - ${s.clientName||"Cliente"} - ${money(s.total)} - ${s.payment==="prazo"?"A prazo":"A vista aguardando recebimento"}`));
 lines.push("","VENDAS","----------------------------------------"); st.sales.slice().sort((a,b)=>String(a.date).localeCompare(String(b.date))).forEach((s,i)=>lines.push(`${i+1}. ${s.date} - ${s.clientName||"Cliente"} - ${s.type==="doce"?"Pao doce":"Pao"} - Qtd ${s.qty||0} - ${money(s.total)} - ${s.payment==="prazo"?"A prazo":(s.payment==="mensal"?"Mensal":"A vista")}${s.paid?" - Recebido":""}`));
 lines.push("","GASTOS COM MATERIA-PRIMA","----------------------------------------"); st.costs.slice().sort((a,b)=>String(a.date).localeCompare(String(b.date))).forEach((c,i)=>lines.push(`${i+1}. ${c.date} - ${c.item} - ${c.qty||""} - ${money(c.total)}${c.supplier?" - "+c.supplier:""}`));
 lines.push("","Documento gerado pelo aplicativo Pao da Dilma.");return lines}
function openPdfBytes(bytes){const blob=new Blob([bytes],{type:"application/pdf"});const url=URL.createObjectURL(blob);const w=window.open(url,"_blank");if(!w){const a=document.createElement("a");a.href=url;a.download="pao-da-dilma-fechamento.pdf";a.click();toast("O PDF foi baixado. Se o navegador bloquear a nova aba, use o arquivo baixado.")}setTimeout(()=>URL.revokeObjectURL(url),60000)}
function generatePdfNow(m){const bytes=buildPdf(buildReportLines(m));openPdfBytes(bytes)}
function closeMonth(m){if(!closeEligible())return toast("O fechamento mensal pode ser feito a partir do dia 10.");const existing=reportForMonth(m);if(existing){viewArchivedReport(existing.id);return}const bytes=buildPdf(buildReportLines(m));const id=crypto.randomUUID();state.reports.push({id,month:m,closedAt:new Date().toISOString(),pdfBase64:bytesToBase64(bytes)});save();toast("Fechamento mensal arquivado em PDF!");renderClosing();openPdfBytes(bytes)}
function viewArchivedReport(id){const r=state.reports.find(x=>x.id===id);if(!r)return toast("Relatório não encontrado.");const bytes=base64ToBytes(r.pdfBase64);openPdfBytes(bytes)}
function renderMore(){
 const last=localStorage.getItem("pao_drive_last_backup");
 const connected=localStorage.getItem("pao_drive_connected")==="1";
 $("#content").innerHTML=`<div class="screenTitleRow"><h2 class="screenTitle">Gastos e Relatórios</h2><button class="btn" onclick="navigate('home')">← Voltar</button></div>
 <section class="panel"><div class="moreGrid"><button class="moreCard" onclick="renderCosts()"><span>🧾</span><b>Gastos</b><small>Matéria-prima</small></button><button class="moreCard" onclick="renderClosing()"><span>📅</span><b>Relatórios</b><small>Fechamento mensal e PDF</small></button></div></section>
 <section class="panel drivePanel"><h3>☁️ Backup no Google Drive</h3><p class="muted">Os dados ficam salvos neste aparelho. O Google Drive só é atualizado quando você tocar em “Fazer backup agora”.</p><div id="driveStatus" class="driveStatus">${last?"Último backup: "+new Date(last).toLocaleString("pt-BR"):connected?"Google Drive conectado.":"Google Drive ainda não conectado."}</div><div class="backupButtons"><button class="btn gold backupBtn" type="button" onclick="driveAuth()">☁️<span>Conectar Google Drive</span></button><button class="btn primary backupBtn" type="button" onclick="backupNow()">💾<span>Fazer backup agora</span></button><button class="btn backupBtn" type="button" onclick="restoreNow()">📥<span>Restaurar backup</span></button><button class="btn backupBtn" type="button" onclick="driveDisconnect()">🔌<span>Desconectar Drive</span></button></div></section>`
}
function newCost(){
 openModal(`<h2>Lançar gasto com matéria-prima</h2><form class="form" id="costForm">
 <div class="formGrid"><label>Data<input name="date" type="date" value="${today()}" required></label><label>Valor total<input name="total" type="number" step="0.01" min="0.01" placeholder="0,00" required></label></div>
 <label>Matéria-prima / item<input name="item" required placeholder="Ex.: farinha de trigo"></label>
 <div class="formGrid"><label>Quantidade<input name="qty" placeholder="Ex.: 10 kg"></label><label>Fornecedor (opcional)<input name="supplier" placeholder="Nome do fornecedor"></label></div>
 <label>Observação (opcional)<textarea name="note" rows="2" placeholder="Ex.: compra para produção da semana"></textarea></label>
 <button class="btn primary" type="submit">Salvar gasto</button></form>`);
 $("#costForm").onsubmit=e=>{e.preventDefault();const f=new FormData(e.target);state.costs.push({id:crypto.randomUUID(),date:f.get("date"),item:f.get("item"),qty:f.get("qty"),supplier:f.get("supplier"),total:Number(f.get("total")),note:f.get("note")});save();closeModal();toast("Gasto lançado!");renderCosts()};
}
function deleteCost(id){if(!confirm("Excluir este gasto?"))return;state.costs=state.costs.filter(c=>c.id!==id);save();renderCosts();toast("Gasto excluído.")}
function navigate(screen){document.querySelectorAll(".bottomNav button").forEach(b=>b.classList.toggle("active",b.dataset.screen===screen)); if(screen==="home")renderHome();if(screen==="clients")renderClients($("#globalSearch").value);if(screen==="sales")renderSales();if(screen==="deliveries")renderDeliveries();if(screen==="receivables")renderReceivables();if(screen==="more")renderMore();if(screen==="closing")renderClosing()}
document.querySelectorAll(".bottomNav button").forEach(b=>b.onclick=()=>navigate(b.dataset.screen));
$("#globalSearch").oninput=e=>{if(document.querySelector(".bottomNav button.active")?.dataset.screen==="clients")renderClients(e.target.value)};
function newClient(existing=null){
 openModal(`<h2>${existing?"Editar":"Novo"} cliente</h2><form class="form" id="clientForm">
 <label>Nome<input name="name" required value="${esc(existing?.name||"")}"></label>
 <label>Telefone<input name="phone" required placeholder="(00) 00000-0000" value="${esc(existing?.phone||"")}"></label>
 <label>Endereço de entrega<input name="address" required value="${esc(existing?.address||"")}"></label>
 <button class="btn primary" type="submit">Salvar cliente</button></form>`);
 $("#clientForm").onsubmit=e=>{e.preventDefault();const f=new FormData(e.target);const c=existing||{id:crypto.randomUUID()};c.name=f.get("name");c.phone=f.get("phone");c.address=f.get("address");if(!existing)state.clients.push(c);save();closeModal();toast("Cliente salvo!");navigate("clients")};
}
function editClient(id){newClient(state.clients.find(c=>c.id===id))}
function deleteClient(id){
 const c=state.clients.find(x=>x.id===id); if(!c)return;
 const open=state.sales.some(s=>s.clientId===id && (s.payment==="prazo" || s.payment==="mensal") && !s.paid);
 if(open){toast("Não é possível excluir: este cliente possui contas em aberto.");return;}
 if(!confirm(`Excluir o cliente ${c.name}? As vendas já registradas serão preservadas no histórico.`))return;
 state.sales.filter(s=>s.clientId===id).forEach(s=>{s.clientName=c.name;s.clientPhone=c.phone;s.clientAddress=c.address;s.clientId=null});
 state.clients=state.clients.filter(x=>x.id!==id); save(); renderClients($("#globalSearch").value); toast("Cliente excluído.");
}
function newSale(pref="pao"){
 if(!state.clients.length){
   openModal(`<div class="emptySale"><div class="emptySaleIcon">🛒</div><h2>Nova venda</h2><p>Para registrar uma venda, primeiro é necessário ter pelo menos um cliente cadastrado.</p><button class="btn primary" onclick="closeModal();newClient()">+ Cadastrar cliente</button></div>`);
   return;
 }
 openModal(`<h2>Nova venda</h2><form class="form" id="saleForm">
 <label>Cliente<select name="client" id="saleClient" required><option value="" selected>Selecione o cliente</option>${state.clients.map(c=>`<option value="${c.id}">${esc(c.name)}</option>`).join("")}</select></label><div id="saleCreditInfo" class="creditInfo" style="display:none"></div>
 <div class="formGrid"><label>Tipo<select name="type"><option value="pao" ${pref==="pao"?"selected":""}>Pão</option><option value="doce" ${pref==="doce"?"selected":""}>Pão doce</option></select></label>
 <label>Quantidade<input name="qty" id="saleQty" type="number" min="1" value="1" required></label></div>
 <div class="formGrid saleValuesGrid"><label>Valor unitário<select name="unitPrice" id="unitPrice"><option value="12">R$ 12,00</option><option value="14">R$ 14,00</option><option value="16">R$ 16,00</option><option value="18" selected>R$ 18,00</option></select></label><label>Valor total<input name="total" id="saleTotal" type="number" step="0.01" min="0" value="18.00" readonly required></label></div>
 <div class="formGrid"><label>Pagamento<select name="payment" id="pay"><option value="avista">À vista</option><option value="prazo">A prazo</option><option value="mensal">Mensal</option></select></label>
 <label>Data da entrega<input name="date" type="date" value="${defaultSaleDate()}" required></label></div>
 <div id="payDateBox" class="hidden"><label>Data para pagamento<input name="payDate" type="date"></label></div>
 <label>Onde entregar<select name="where"><option value="casa">🏠 Casa</option><option value="trabalho">🏢 Trabalho</option></select></label>
 <button class="btn primary" type="submit">Registrar venda</button></form>`);
 $("#pay").onchange=e=>$("#payDateBox").classList.toggle("hidden",e.target.value!=="prazo");
 const updateSaleTotal=()=>{const qty=Math.max(1,Number($("#saleQty").value||1));const unit=Number($("#unitPrice").value||12);$("#saleTotal").value=(qty*unit).toFixed(2)};
 $("#saleQty").oninput=updateSaleTotal; $("#unitPrice").onchange=updateSaleTotal;
 $("#saleClient").onchange=()=>{const cid=$("#saleClient").value;const cr=creditTotalFor(cid);const el=$("#saleCreditInfo");if(el){el.style.display=cr>0?"block":"none";el.textContent=cr>0?`💳 Crédito disponível para esta compra: ${money(cr)}`:"";}};
 $("#saleForm").onsubmit=e=>{e.preventDefault();const f=new FormData(e.target);const clientId=String(f.get("client")||"").trim();if(!clientId){toast("Selecione um cliente antes de registrar a venda.");$("select[name=client]").focus();return;}const client=state.clients.find(c=>c.id===clientId);if(!client){toast("Cliente inválido. Selecione um cliente cadastrado.");return;}const originalTotal=Number(f.get("total"));const creditAvailable=creditTotalFor(clientId);const creditUsed=useCredit(clientId,Math.min(originalTotal,creditAvailable));const finalTotal=Number((originalTotal-creditUsed).toFixed(2));const s={id:crypto.randomUUID(),clientId:clientId,clientName:client.name,clientPhone:client.phone||"",clientAddress:client.address||"",type:f.get("type"),qty:Number(f.get("qty")),unitPrice:Number(f.get("unitPrice")),sugar:f.get("sugar"),total:originalTotal,payment:f.get("payment"),payDate:f.get("payDate")||null,date:f.get("date"),where:f.get("where"),delivered:false,time:new Date().toLocaleTimeString("pt-BR",{hour:"2-digit",minute:"2-digit"}),creditUsed};state.sales.push(s);save();closeModal();toast(creditUsed>0?`Venda registrada. Crédito utilizado: ${money(creditUsed)}${finalTotal>0?` · Restante a pagar: ${money(finalTotal)}`:" · Venda totalmente coberta pelo crédito."}`:"Venda registrada!");navigate("sales")}
}
function editSale(id){
 const s=state.sales.find(x=>x.id===id); if(!s)return;
 if(s.paid){toast("Esta venda já foi recebida e não pode ser editada para preservar o histórico financeiro.");return;}
 openModal(`<h2>Editar venda</h2><form class="form" id="editSaleForm">
 <label>Cliente<select name="client" required>${state.clients.map(c=>`<option value="${c.id}" ${c.id===s.clientId?"selected":""}>${esc(c.name)}</option>`).join("")}</select></label>
 <div class="formGrid"><label>Tipo<select name="type"><option value="pao" ${s.type==="pao"?"selected":""}>Pão</option><option value="doce" ${s.type==="doce"?"selected":""}>Pão doce</option></select></label>
 <label>Quantidade<input name="qty" id="editSaleQty" type="number" min="1" value="${Number(s.qty)||1}" required></label></div>
 <div class="formGrid saleValuesGrid"><label>Valor unitário<select name="unitPrice" id="editUnitPrice">${[12,14,16,18].map(v=>`<option value="${v}" ${Number(s.unitPrice)===v?"selected":""}>R$ ${v.toFixed(2).replace(".",",")}</option>`).join("")}</select></label><label>Valor total<input name="total" id="editSaleTotal" type="number" step="0.01" min="0" value="${Number(s.total||0).toFixed(2)}" readonly required></label></div>
 <div class="formGrid"><label>Pagamento<select name="payment" id="editPay"><option value="avista" ${s.payment==="avista"?"selected":""}>À vista</option><option value="prazo" ${s.payment==="prazo"?"selected":""}>A prazo</option><option value="mensal" ${s.payment==="mensal"?"selected":""}>Mensal</option></select></label><label>Data da entrega<input name="date" type="date" value="${s.date||todayDate()}" required></label></div>
 <div id="editPayDateBox" class="${s.payment==="prazo"?"":"hidden"}"><label>Data para pagamento<input name="payDate" type="date" value="${s.payDate||""}"></label></div>
 <label>Onde entregar<select name="where"><option value="casa" ${s.where!=="trabalho"?"selected":""}>🏠 Casa</option><option value="trabalho" ${s.where==="trabalho"?"selected":""}>🏢 Trabalho</option></select></label>
 <button class="btn primary" type="submit">Salvar alterações</button></form>`);
 const update=()=>{const q=Math.max(1,Number($("#editSaleQty").value||1));const u=Number($("#editUnitPrice").value||12);$("#editSaleTotal").value=(q*u).toFixed(2)};
 $("#editSaleQty").oninput=update; $("#editUnitPrice").onchange=update; $("#editPay").onchange=e=>$("#editPayDateBox").classList.toggle("hidden",e.target.value!=="prazo");
 $("#editSaleForm").onsubmit=e=>{e.preventDefault();const f=new FormData(e.target);const c=state.clients.find(x=>x.id===String(f.get("client")));if(!c)return toast("Cliente inválido.");s.clientId=c.id;s.clientName=c.name;s.clientPhone=c.phone||"";s.clientAddress=c.address||"";s.type=f.get("type");s.qty=Number(f.get("qty"));s.unitPrice=Number(f.get("unitPrice"));s.total=Number(f.get("total"));s.payment=f.get("payment");s.payDate=f.get("payDate")||null;s.date=f.get("date");s.where=f.get("where");save();closeModal();renderSales();toast("Venda alterada com sucesso!")};
}
function deleteSale(id){
 const s=state.sales.find(x=>x.id===id); if(!s)return;
 const c=state.clients.find(x=>x.id===s.clientId); const nome=c?.name||s.clientName||"Cliente";
 if(!confirm(`Excluir a venda de ${nome} no valor de ${money(s.total)}?\n\nEsta ação não poderá ser desfeita.`))return;
 state.sales=state.sales.filter(x=>x.id!==id); save(); renderSales(); toast("Venda excluída.");
}
function deliver(id){const s=state.sales.find(x=>x.id===id);if(!s)return;const c=state.clients.find(x=>x.id===s.clientId);const nome=c?.name||s.clientName||"cliente";if(!confirm(`Confirmar que a entrega de ${nome} foi realizada?`))return;s.delivered=true;s.deliveredAt=todayDate();if(s.paid!==true)s.paid=false;save();updateBadges();renderDeliveries();toast(s.payment==="avista"?"Entrega confirmada. A venda foi enviada para A receber.":"Entrega marcada como concluída!")}
function showPurchaseReport(k){
 const [cid,month]=k.split("_");
 const c=state.clients.find(x=>x.id===cid);
 const sales=state.sales.filter(s=>s.clientId===cid && String(s.date||"").slice(0,7)===month);
 if(!sales.length){toast("Nenhuma compra encontrada para este mês.");return;}
 const total=sales.reduce((a,s)=>a+Number(s.total||0),0);
 const qty=sales.reduce((a,s)=>a+Number(s.qty||0),0);
 const rows=sales.slice().sort((a,b)=>String(a.date).localeCompare(String(b.date))).map(s=>`<div class="reportLine"><div><b>${String(s.date||"").split("-").reverse().join("/")}</b><div class="muted">${s.type==="doce"?"Pão doce":"Pão"} · ${s.qty||0} un. · ${money(s.unitPrice||0)} cada</div></div><div class="reportValue"><b>${money(s.total||0)}</b><small>${s.delivered?"Entregue":"Pendente"}</small></div></div>`).join("");
 openModal(`<h2>Compras de ${esc(c?.name||"Cliente")}</h2><div class="muted">${monthLabel(month)}</div>${creditTotalFor(cid)>0?`<div class="creditInfo">💳 Crédito disponível após recebimentos: <b>${money(creditTotalFor(cid))}</b></div>`:""}<div class="reportSummary"><div><small>Compras</small><b>${sales.length}</b></div><div><small>Quantidade</small><b>${qty}</b></div><div><small>Total do mês</small><b>${money(total)}</b></div></div><section class="reportList">${rows}</section><div class="toolbar"><button class="btn gold" onclick="closeModal()">Fechar</button></div>`);
}

function payGroup(k){
 const [cid,month]=k.split("_");
 const sales=state.sales.filter(s=>s.clientId===cid&&(s.payDate||s.date).slice(0,7)===month&&!s.paid);
 if(!sales.length)return;
 const c=state.clients.find(x=>x.id===cid);
 const nome=c?.name||"cliente";
 const total=sales.reduce((a,s)=>a+Number(s.total||0),0);
 const already=receiptTotalFor(cid,month);
 const due=Math.max(0,total-already);
 openModal(`<h2>Confirmar recebimento</h2><div class="receiptModalInfo"><p><b>Cliente:</b> ${esc(nome)}</p><p><b>Valor em aberto:</b> ${money(due)}</p><label class="receiptAmountLabel"><span>Valor recebido</span><input id="receiptAmount" type="text" inputmode="decimal" value="${due.toFixed(2).replace(".",",")}" placeholder="0,00" autocomplete="off"></label><p class="muted small">Você pode informar um valor maior ou menor que o valor em aberto.</p></div><div class="toolbar receiptModalActions"><button class="btn gold" onclick="registerReceipt('${k}')">Confirmar recebimento</button><button class="btn" onclick="closeModal()">Cancelar</button></div>`);
 setTimeout(()=>{const el=$("#receiptAmount");if(el){el.focus();el.select();}},50);
}
function registerReceipt(k){
 const [cid,month]=k.split("_");
 const sales=state.sales.filter(s=>s.clientId===cid&&(s.payDate||s.date).slice(0,7)===month&&!s.paid);
 if(!sales.length){closeModal();return;}
 const c=state.clients.find(x=>x.id===cid);
 const nome=c?.name||"cliente";
 const total=sales.reduce((a,s)=>a+Number(s.total||0),0);
 const already=receiptTotalFor(cid,month);
 const due=Math.max(0,total-already);
 const el=$("#receiptAmount");
 const raw=el?.value||"";
 const amount=Number(String(raw).replace(/\./g,"").replace(",","."));
 if(!Number.isFinite(amount)||amount<=0){toast("Informe um valor de recebimento válido.");el?.focus();return;}
 closeModal();
 openModal(`<h2>Confirmar recebimento</h2><div class="receiptModalInfo"><p>Registrar <b>${money(amount)}</b> recebido de <b>${esc(nome)}</b>?</p><p class="muted">Valor em aberto: ${money(due)}</p></div><div class="toolbar receiptModalActions"><button class="btn gold" onclick="finishReceipt('${k}',${amount})">Confirmar</button><button class="btn" onclick="closeModal()">Cancelar</button></div>`);
}
function finishReceipt(k,amount){
 const [cid,month]=k.split("_");
 const sales=state.sales.filter(s=>s.clientId===cid&&(s.payDate||s.date).slice(0,7)===month&&!s.paid);
 if(!sales.length){closeModal();return;}
 const total=sales.reduce((a,s)=>a+Number(s.total||0),0);
 const already=receiptTotalFor(cid,month);
 const due=Math.max(0,total-already);
 state.receipts.push({id:crypto.randomUUID(),clientId:cid,month,amount,date:today()});
 closeModal();
 if(amount>=due){sales.forEach(s=>{s.paid=true;s.paidAt=today()});if(amount>due){const excess=Number((amount-due).toFixed(2));addCredit(cid,excess);toast(`Recebimento registrado. Crédito de ${money(excess)} gerado para a próxima compra.`);}else{toast("Recebimento registrado!");}}
 else {toast(`Recebimento parcial registrado. Restam ${money(due-amount)}.`);}
 save();renderReceivables();
}
function charge(cid,total){const c=state.clients.find(x=>x.id===cid);if(!c)return;wa(c.phone,`Tudo bem ${c.name}, tem uma notinha sua aqui, são ${money(total)}. Consegue mandar pix pra mim?`)}
function openRoute(){const selected=deliveryViewDate||todayDate();const list=state.sales.filter(s=>s.date===selected&&!s.delivered).map(s=>state.clients.find(c=>c.id===s.clientId)?.address).filter(Boolean);if(!list.length)return toast("Não há entregas pendentes para a data selecionada.");window.open(maps(list.join(" | ")),"_blank")}
function updateBadges(){const pending=state.sales.filter(s=>s.date===today()&&!s.delivered).length;const db=$("#deliveryBadge");if(db)db.textContent=pending;const nb=$("#notifyCount");if(nb)nb.textContent=state.sales.filter(s=>s.delivered&&!s.paid).length;const nav=$("#navDueAmount");if(nav)nav.textContent="R$"}
$("#notifyBtn").onclick=()=>navigate("receivables");
renderHome();
updateBottomNav();
if("serviceWorker" in navigator) navigator.serviceWorker.register("sw.js").catch(()=>{});
